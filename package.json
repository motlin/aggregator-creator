{
	"name": "aggregator-creator",
	"version": "0.0.0",
	"description": "CLI for managing Maven repositories and creating aggregator POMs",
	"keywords": [
		"aggregator",
		"cli",
		"maven",
		"oclif",
		"pom"
	],
	"homepage": "https://github.com/motlin/aggregator-creator",
	"bugs": "https://github.com/motlin/aggregator-creator/issues",
	"license": "Apache 2.0",
	"author": "Craig P. Motlin",
	"repository": "motlin/aggregator-creator",
	"bin": {
		"aggregator": "./bin/run.js"
	},
	"files": [
		"./bin",
		"./dist",
		"./oclif.manifest.json"
	],
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"oxlint": "vp lint . --fix",
		"oxlint:ci": "vp lint . --format github",
		"fmt": "vp fmt",
		"fmt:ci": "vp fmt --check",
		"fallow": "fallow fix --yes --no-create-config",
		"fallow:ci": "fallow dead-code",
		"typecheck": "tsc --noEmit",
		"test": "node node_modules/vitest/dist/cli.js",
		"prepare": "VITE_GIT_HOOKS=0 vp config",
		"postpack": "shx rm -f oclif.manifest.json",
		"prepack": "oclif manifest && oclif readme",
		"version": "oclif readme && git add README.md",
		"prepublishOnly": "vp run build && vp run test:run && pnpm run oxlint:ci",
		"release:patch": "npm version patch && npm publish",
		"release:minor": "npm version minor && npm publish",
		"release:major": "npm version major && npm publish"
	},
	"dependencies": {
		"@oclif/core": "4.11.6",
		"@oclif/plugin-help": "7.0.5",
		"chalk": "6.0.1",
		"execa": "10.2.1",
		"fs-extra": "11.4.1",
		"inquirer": "14.2.4",
		"xml2js": "0.6.2",
		"xmlbuilder2": "4.0.3",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@oclif/test": "4.2.0",
		"@types/chai": "5.2.3",
		"@types/fs-extra": "11.0.4",
		"@types/node": "^26.6.5",
		"@types/sinon": "22.0.0",
		"@types/xml2js": "0.4.14",
		"chai": "6.3.0",
		"fallow": "^3.34.1",
		"markdownlint-cli2": "^0.24.0",
		"oclif": "6.0.10",
		"shx": "0.4.0",
		"sinon": "22.1.0",
		"tsx": "4.23.15",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:"
	},
	"oclif": {
		"bin": "aggregator",
		"commands": "./dist/commands",
		"dirname": "aggregator",
		"plugins": [
			"@oclif/plugin-help"
		],
		"topicSeparator": " ",
		"topics": {
			"aggregator": {
				"description": "Maven aggregator POM management"
			},
			"repo": {
				"description": "Repository management commands"
			}
		}
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"packageManager": "pnpm@12.11.2"
}
